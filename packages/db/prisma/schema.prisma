// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  uploadVideos UploadVideo[]
}

// Model for the video user have upload to the system :- 
model UploadVideo {
  id              String          @id @default(uuid())
  filename        String
  fileSize        Decimal? // May be in bytes
  mimeType        String
  s3Key           String
  uploadId        String
  status          UploadStatus
  userId          String // Id of the user uploaded the video
  userDetails     User            @relation(fields: [userId], references: [id])
  transcript      Json? // We can directly dump the entire json of video file done by whisper model
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  extractedAudios ExtractedAudio?
  clips           Clip[]
  videoParts      VideoPart[]
}

// Model for storing the Etag and PartNumber :-
model VideoPart {
  id           String      @id @default(uuid())
  etag         String
  partNumber   String
  videoId      String
  videoDetails UploadVideo @relation(fields: [videoId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Model for the extracted audio file per video by FFMpeg :-
model ExtractedAudio {
  id           String      @id @default(uuid())
  filename     String // Same as video name we uploaded
  mimetype     String
  fileSize     Decimal // Store in bytes
  videoId      String      @unique
  VideoDetails UploadVideo @relation(fields: [videoId], references: [id])
}

model Clip {
  id           String      @id @default(uuid())
  s3Key        String
  clipName     String // Can we generated by us by using the file original name of video and some random id
  startTime    String // "01:30"
  endTime      String // "3:00"
  clipSize     Decimal? // In bytes as well 
  videoId      String // Clip Of which Video
  videoDetails UploadVideo @relation(fields: [videoId], references: [id])
}

// Some models for User Subscription or pricing package will Arrive Soon Later on 

enum UploadStatus {
  initialized
  uploading
  uploaded
  failed
  pending
  processing
  completed
}
